  "executor_python": "import base64,sys,json,hashlib,shutil\nfrom pathlib import Path\nimport numpy as np\nfrom scripts.analyze_hfo2_channel_network import read_evaluated_observation\nfrom scripts.audit_hfo2_static_replica import audited_results,sha256\nfrom examples.hfo2_fixed_input_factory import CONTRACT,same_ordered_geometry\nfrom ase.io import read\nfrom vcneb.polarization import sampled_band_gap\nbase=Path('benchmarks/hfo2_channels/20261008')\nentries=[('PO_to_T','converged_gap/gap_converged_step06'),('PO_to_M','terminal_G1_update_20261009_17/M_refined_step01'),('PO_flip_T_pattern_preserving','switching_converged_update_20261009_1255/preserving_step69'),('PO_flip_T_pattern_reversing','terminal_G1_update_20261009_17/reversing_step45')]\nout=Path('/public/home/iai806/abacus/agent-runs/20261009-varneb-reversing-peaks-E043-r4/raw_gap_audit')\nassert not out.exists()\nout.mkdir()\nchannels=[]\nfor name,folder in entries:\n images,record,digest=read_evaluated_observation(base/folder)\n assert record['replayed_fmax_eV_A']<=.1\n target=out/name;target.mkdir()\n rows=[]\n for i,(a,p) in enumerate(zip(images,record['raw_image_evaluations'])):\n  d=Path(p['raw_source']);actual=audited_results(d)\n  assert sha256(d/'OUT.ABACUS/running_scf.log')==p['raw_log_sha256']\n  assert all(sha256(d/n)==h for n,h in CONTRACT.items())\n  assert same_ordered_geometry(a,read(d/'STRU',format='abacus'))\n  assert abs(actual['energy']-a.get_potential_energy())<1e-10\n  assert np.allclose(actual['forces'],a.get_forces(),rtol=0,atol=1e-12)\n  assert np.allclose(actual['stress'],a.get_stress(),rtol=0,atol=1e-12)\n  source=d/'OUT.ABACUS/istate.info';dest=target/f'istate_{i:02d}.info';shutil.copyfile(source,dest)\n  gap=sampled_band_gap(source.read_text(),48)\n  rows.append({'source_image_index':i,'raw_source':str(d),'istate_sha256':sha256(source),'raw_log_sha256':p['raw_log_sha256'],'gap':gap})\n channels.append({'name':name,'observation_sha256':digest,'rows':rows,'minimum_sampled_gap_eV':min(x['gap']['sampled_indirect_gap_eV'] for x in rows)})\ncode=base64.b64decode(sys.argv[1])\nresult={'status':'actual_raw_terminal_sampled_gaps_not_full_BZ_or_Berry_branch','executor_sha256':hashlib.sha256(code).hexdigest(),'executor_python':code.decode(),'channels':channels,'records':sum(len(c['rows']) for c in channels),'new_DFT_calls':0,'physical_inputs_changed':False,'ordinary_passes':4,'full_G1_passed':False,'limitations':'sampled Gamma2x2x2 eigenvalues only, 48 occupied bands; no gap along unsampled links, no Berry/path branch selected'}\n(out/'report.json').write_text(json.dumps(result,indent=2,allow_nan=False)+'\\n')\nprint(json.dumps({'records':result['records'],'minimum_sampled_gaps_eV':{c['name']:c['minimum_sampled_gap_eV'] for c in channels},'new_DFT':0}))",
